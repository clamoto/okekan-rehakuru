# ====================================================================
# オケカン / リハクル 環境変数設定サンプル (.env.local.example)
# ====================================================================

# Next.js アプリケーションURL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase 設定 (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe & Stripe Connect 設定 (Stripe Dashboard -> Developers -> API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CONNECT_CLIENT_ID=ca_your_stripe_connect_client_id
